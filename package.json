{
  "name": "time2ship",
  "version": "1.0.0",
  "private": true,
  "description": "Time2Ship Boilerplate - Monorepo",
  "scripts": {
    "prepare": "husky",
    "review": "./.husky/scripts/review-changes.sh",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "workspaces": [
    "apps/client",
    "apps/api",
    "packages/types",
    "packages/validators",
    "packages/utils",
    "packages/config"
  ],
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ],
    "apps/client/**/*.{ts,tsx}": [
      "cd apps/client && npm run lint --fix",
      "cd apps/client && tsc --noEmit"
    ],
    "apps/api/**/*.ts": [
      "cd apps/api && npm run lint -- --fix",
      "cd apps/api && npm run type-check"
    ]
  },
  "devDependencies": {
    "depcheck": "^1.4.7",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.0",
    "prettier": "^3.8.0",
    "snyk": "^1.1302.0"
  }
}
