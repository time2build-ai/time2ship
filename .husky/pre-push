#!/bin/sh

echo "🚀 Pre-push checks starting..."
echo ""

# Check if there are commits to push
if git diff --quiet HEAD @{u} 2>/dev/null; then
    echo "No new commits to push."
    exit 0
fi

echo "📊 New commits detected!"
echo ""

# Step 1: Offer code review BEFORE running tests
echo "Would you like to run code review with code-simplifier?"
echo "(Recommended: Review and improve code before running tests)"
echo ""
printf "Run code review? [y/N] "

# Read user input (only in interactive terminal)
if [ -t 0 ]; then
    read -r response
    case "$response" in
        [yY][eE][sS]|[yY])
            echo ""
            echo "🤖 Running code review..."
            .husky/scripts/review-changes.sh
            echo ""
            echo "⚠️  If you made changes based on the review:"
            echo "   1. Stage your changes: git add ."
            echo "   2. Commit them: git commit -m \"refactor: apply code review suggestions\""
            echo "   3. Try pushing again"
            echo ""
            printf "Did you make changes that need to be committed? [y/N] "
            read -r made_changes
            case "$made_changes" in
                [yY][eE][sS]|[yY])
                    echo ""
                    echo "Please commit your changes and push again."
                    echo "Aborting push..."
                    exit 1
                    ;;
                *)
                    echo "Continuing with push..."
                    ;;
            esac
            ;;
        *)
            echo "Skipping code review."
            ;;
    esac
else
    echo "Non-interactive terminal. Skipping code review prompt."
    echo "Run '.husky/scripts/review-changes.sh' manually to review changes."
fi

# Step 2: Run tests AFTER code review (or if review was skipped)
echo ""
echo "🧪 Running API e2e tests..."

# Change to API directory and run e2e tests
cd apps/api && npm run test:e2e

# Check if tests passed
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ API e2e tests failed! Push aborted."
    echo "Fix the failing tests before pushing."
    echo ""
    echo "To skip this hook (not recommended):"
    echo "  git push --no-verify"
    echo ""
    exit 1
fi

echo ""
echo "✅ All checks passed! Pushing to remote..."
