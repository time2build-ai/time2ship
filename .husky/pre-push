#!/bin/sh

echo "🚀 Pre-push checks starting..."
echo ""

# Check if there are commits to push
if git diff --quiet HEAD @{u} 2>/dev/null; then
    echo "No new commits to push."
    exit 0
fi

echo "📊 New commits detected!"
echo ""

# Step 1: Security checks (vulnerabilities & unused dependencies)
echo ""
echo "🔒 Running security checks..."
echo ""

./.husky/scripts/security-checks.sh

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Security checks failed! Push aborted."
    echo "Review and fix security issues before pushing."
    echo ""
    echo "To skip this hook (not recommended):"
    echo "  git push --no-verify"
    echo ""
    exit 1
fi

# Step 2: Build client app
echo ""
echo "🏗️  Building client app..."
echo ""

cd apps/client && npm run build

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Client build failed! Push aborted."
    echo "Fix the build errors before pushing."
    echo ""
    echo "To skip this hook (not recommended):"
    echo "  git push --no-verify"
    echo ""
    exit 1
fi

# Step 3: Build API app
echo ""
echo "🏗️  Building API app..."
echo ""

cd ../api && npm run build

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ API build failed! Push aborted."
    echo "Fix the build errors before pushing."
    echo ""
    echo "To skip this hook (not recommended):"
    echo "  git push --no-verify"
    echo ""
    exit 1
fi

# Step 4: Run API e2e tests
echo ""
echo "🧪 Running API e2e tests..."
echo ""

npm run test:e2e

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ API e2e tests failed! Push aborted."
    echo "Fix the failing tests before pushing."
    echo ""
    echo "To skip this hook (not recommended):"
    echo "  git push --no-verify"
    echo ""
    exit 1
fi

echo ""
echo "✅ All checks passed! Pushing to remote..."
