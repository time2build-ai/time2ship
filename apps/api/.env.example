# Server
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=time2ship
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secrets (CHANGE IN PRODUCTION - generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=your-32-character-secret-change-me-in-production
JWT_REFRESH_SECRET=another-32-character-secret-change-me-too

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@time2ship.com
EMAIL_FROM_NAME=Time2Ship
CLIENT_URL=http://localhost:3000

# Redis Configuration (Optional - for distributed rate limiting)
# REDIS_URL=redis://localhost:6379

# Sentry Configuration (Optional - for error monitoring)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
